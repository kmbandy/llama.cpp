#version 450

// paged_attn_scatter.comp — type-generic scatter of K_cur/V_cur into the paged
// K/V cache. Mirrors mt_scatter_kv_kernel (mt_pagedattn.cu:174-225). For the F16
// cache type this is a pure permutation copy (element-granular store, no
// cooperative quantization — that is a Task 4 concern for quant types).
//
// Threading: local_size_x = HEAD_SIZE (one thread per head-dim element d).
// One workgroup per (token, kv_head); gl_WorkGroupID.z selects K (0) vs V (1).
//
// wave64-safe: no subgroup ops.

#extension GL_EXT_shader_explicit_arithmetic_types_int32   : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage                     : require
#extension GL_EXT_control_flow_attributes                  : require
#if defined(DATA_A_TURBO4_0) || defined(DATA_A_TURBO4_64) || defined(DATA_A_TURBO4_64_OL) || defined(DATA_A_Q8_0)
#extension GL_EXT_shader_explicit_arithmetic_types_int8    : require
#extension GL_EXT_shader_8bit_storage                      : require
#endif

#if defined(DATA_A_TURBO4_64) || defined(DATA_A_TURBO4_64_OL)
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
#elif defined(DATA_A_Q8_0)
layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;
#else
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
#endif

layout (push_constant) uniform parameter {
    uint HS;            // head size (head_dim)
    uint BS;            // block size
    uint n_kv_heads;
    uint n_tokens;      // total tokens (sum of q_lens)
    // Outlier-matrix sweep (2026-07-01, investigative-only): nonzero selects
    // the N=64-calibrated centroid table for turbo4_64_ol/ol8/ol12's
    // non-outlier elements (GGML_TURBO4_64_OL_TABLE=n64 on the host). Ignored
    // by every other cache type. See paged_cache_ops.glsl / ggml-vulkan.cpp.
    uint use_n64_table;
} p;

// K_cur / V_cur scatter INPUTS are always F16 regardless of cache type.
layout (binding = 0) readonly  buffer SlotMap { int       slot_mapping[]; };
layout (binding = 1) readonly  buffer KCur    { float16_t k_cur[]; };
layout (binding = 2) readonly  buffer VCur    { float16_t v_cur[]; };

// Cache buffers differ by cache type — guard the declarations.
#ifdef DATA_A_F16
layout (binding = 3)           buffer KCache  { float16_t data_k[]; };
layout (binding = 4)           buffer VCache  { float16_t data_v[]; };
#endif
#ifdef DATA_A_TURBO4_0
struct block_turbo4_0 {
    float16_t norm;      // corrected L2 norm (fp16)
    float16_t rnorm;     // reserved (written as 0)
    uint8_t   qs[64];    // 4-bit centroid indices, nibble-packed
};
layout (binding = 3)           buffer KCache  { block_turbo4_0 data_k[]; };
layout (binding = 4)           buffer VCache  { block_turbo4_0 data_v[]; };
#endif
#ifdef DATA_A_TURBO4_64
struct block_turbo4_64 {
    float16_t norm;      // corrected L2 norm (fp16), NO rnorm field
    uint8_t   qs[32];    // 4-bit centroid indices, nibble-packed (64 elements)
};
layout (binding = 3)           buffer KCache  { block_turbo4_64 data_k[]; };
layout (binding = 4)           buffer VCache  { block_turbo4_64 data_v[]; };
#endif
#ifdef DATA_A_TURBO4_64_OL
// N (outlier count) is parameterized via PA_TURBO4_64_OL_N (default 4u,
// see paged_cache_ops.glsl) so this struct/pipeline is shared by the
// turbo4_64_ol (N=4), turbo4_64_ol8 (N=8), and turbo4_64_ol12 (N=12)
// variants, each compiled with a different -D from vulkan-shaders-gen.cpp.
#ifndef PA_TURBO4_64_OL_N
#define PA_TURBO4_64_OL_N 4u
#endif
struct block_turbo4_64_ol {
    float16_t norm;                        // corrected L2 norm of the non-outlier elements
    float16_t outliers[PA_TURBO4_64_OL_N];  // full-precision values at the fixed outlier channels
    uint8_t   qs[(64u - PA_TURBO4_64_OL_N) / 2u]; // 4-bit centroid indices for the remaining elements, nibble-packed
};
layout (binding = 3)           buffer KCache  { block_turbo4_64_ol data_k[]; };
layout (binding = 4)           buffer VCache  { block_turbo4_64_ol data_v[]; };
#endif
#ifdef DATA_A_Q8_0
struct block_q8_0 {
    float16_t d;         // scale
    int8_t    qs[32];    // signed 8-bit quantized values
};
layout (binding = 3)           buffer KCache  { block_q8_0 data_k[]; };
layout (binding = 4)           buffer VCache  { block_q8_0 data_v[]; };
#endif

#include "paged_cache_ops.glsl"

#ifdef DATA_A_F16
void main() {
    const uint token     = gl_WorkGroupID.x;          // global token index
    const uint y_idx     = gl_WorkGroupID.y;          // kv_head*N_QBLK + qb
    const uint kv_select = gl_WorkGroupID.z;          // 0 = K, 1 = V
    const uint lane      = gl_LocalInvocationID.x;     // 0..127

    if (token >= p.n_tokens) { return; }
    const uint N_QBLK = p.HS / 128u;
    const uint kv_head = y_idx / N_QBLK;
    const uint qb      = y_idx % N_QBLK;
    const uint d       = qb * 128u + lane;
    if (d >= p.HS) { return; }

    const int slot = slot_mapping[token];
    if (slot < 0) { return; }                          // padding token
    const uint paged_block = uint(slot) / p.BS;
    const uint tok         = uint(slot) % p.BS;

    const uint src = token * p.n_kv_heads * p.HS + kv_head * p.HS + d;
    if (kv_select == 0u) {
        pa_k_store(pa_k_off(paged_block, kv_head, p.n_kv_heads, tok, d, p.HS, p.BS), float(k_cur[src]));
    } else {
        pa_v_store(pa_v_off(paged_block, kv_head, p.n_kv_heads, tok, d, p.HS, p.BS), float(v_cur[src]));
    }
}
#endif // DATA_A_F16

#ifdef DATA_A_TURBO4_0
// Cooperative no-RHT turbo4 quantizer. Mirrors mt_scatter_kv_turbo4_0_kernel
// (mt_pagedattn.cu:323-454): one workgroup per (token, kv_head*N_QBLK+qb, K/V),
// 128 threads = one element each. Sequence: load -> L2 norm -> normalize ->
// (NO Hadamard) -> nearest centroid -> nibble-pack -> recon-norm-correct.
// wave64-safe: shared-memory tree reductions, no subgroup ops.
shared float s_x[128];     // working values (normalized in place)
shared float s_red[128];   // tree-reduction / nibble-share scratch

void main() {
    const uint j         = gl_LocalInvocationID.x;   // 0..127, element within the turbo4 block
    const uint token     = gl_WorkGroupID.x;         // global token index
    const uint y_idx     = gl_WorkGroupID.y;         // kv_head*N_QBLK + qb
    const uint kv_select = gl_WorkGroupID.z;         // 0 = K, 1 = V

    if (token >= p.n_tokens) {
        return;                                      // uniform across workgroup
    }

    const uint N_QBLK = p.HS / 128u;
    const uint kv_head = y_idx / N_QBLK;
    const uint qb      = y_idx % N_QBLK;

    const int slot = slot_mapping[token];
    if (slot < 0) {
        return;                                      // padding token (uniform)
    }

    const uint paged_block = uint(slot) / p.BS;
    const uint tok         = uint(slot) % p.BS;
    const uint d           = qb * 128u + j;

    // K_cur / V_cur layout: ne[0]=head_dim, ne[1]=n_kv_heads, ne[2]=n_tokens.
    const uint src = token * p.n_kv_heads * p.HS + kv_head * p.HS + d;
    const float val = (kv_select == 0u) ? float(k_cur[src]) : float(v_cur[src]);

    const uint block_ib = pa_turbo_block_index(paged_block, kv_head, p.n_kv_heads, tok, qb, p.HS, p.BS);

    // ---- Step 1: load into shared mem ----
    s_x[j] = val;
    barrier();

    // ---- Step 2: parallel L2 norm (7-stage binary tree) ----
    s_red[j] = s_x[j] * s_x[j];
    barrier();
    if (j < 64u) { s_red[j] += s_red[j + 64u]; } barrier();
    if (j < 32u) { s_red[j] += s_red[j + 32u]; } barrier();
    if (j < 16u) { s_red[j] += s_red[j + 16u]; } barrier();
    if (j <  8u) { s_red[j] += s_red[j +  8u]; } barrier();
    if (j <  4u) { s_red[j] += s_red[j +  4u]; } barrier();
    if (j <  2u) { s_red[j] += s_red[j +  2u]; } barrier();
    if (j <  1u) { s_red[j] += s_red[j +  1u]; } barrier();

    const float grp_norm = sqrt(s_red[0]);
    const float inv_norm = (grp_norm > 1e-10f) ? (1.0f / grp_norm) : 0.0f;

    // ---- Step 3: normalize ----
    s_x[j] *= inv_norm;
    barrier();

    // ---- Step 4: (intentionally NO Randomized Hadamard Transform) ----

    // ---- Step 5: nearest centroid ----
    const uint idx = pa_turbo_nearest_4bit(s_x[j]);

    // ---- Step 7 (parallel): reconstruction norm = sqrt(Σ centroid²) ----
    // WAR: all lanes have read s_red[0] (grp_norm) before any lane overwrites it.
    barrier();
    const float cv = TURBO_CENTROIDS_4BIT[idx];
    s_red[j] = cv * cv;
    barrier();
    if (j < 64u) { s_red[j] += s_red[j + 64u]; } barrier();
    if (j < 32u) { s_red[j] += s_red[j + 32u]; } barrier();
    if (j < 16u) { s_red[j] += s_red[j + 16u]; } barrier();
    if (j <  8u) { s_red[j] += s_red[j +  8u]; } barrier();
    if (j <  4u) { s_red[j] += s_red[j +  4u]; } barrier();
    if (j <  2u) { s_red[j] += s_red[j +  2u]; } barrier();
    if (j <  1u) { s_red[j] += s_red[j +  1u]; } barrier();

    const float recon_norm     = sqrt(s_red[0]);
    const float corrected_norm = (recon_norm > 1e-10f) ? (grp_norm / recon_norm) : grp_norm;

    // ---- Step 6: nibble-pack qs cooperatively ----
    // Share indices via s_red so even lanes can pair them. WAR: all lanes have
    // consumed s_red[0] (recon_norm) before any lane overwrites s_red.
    barrier();
    s_red[j] = float(idx);
    barrier();

    // ---- Step 8: thread 0 writes per-block scalars ----
    if (j == 0u) {
        if (kv_select == 0u) {
            data_k[block_ib].norm  = float16_t(corrected_norm);
            data_k[block_ib].rnorm = float16_t(0.0f);
        } else {
            data_v[block_ib].norm  = float16_t(corrected_norm);
            data_v[block_ib].rnorm = float16_t(0.0f);
        }
    }

    if ((j & 1u) == 0u) {
        const uint lo = uint(s_red[j]);
        const uint hi = uint(s_red[j + 1u]);
        const uint8_t packed = uint8_t((lo & 0xFu) | ((hi & 0xFu) << 4u));
        if (kv_select == 0u) {
            data_k[block_ib].qs[j >> 1u] = packed;
        } else {
            data_v[block_ib].qs[j >> 1u] = packed;
        }
    }
}
#endif // DATA_A_TURBO4_0

#ifdef DATA_A_TURBO4_64
// Cooperative no-RHT turbo4_64 quantizer. Mirrors the turbo4_0 quantizer
// above (mt_scatter_kv_turbo4_64_kernel, mt_pagedattn.cu), just over a
// 64-element block with 64 active threads (one workgroup = one block).
// Sequence: load -> L2 norm -> normalize -> (NO Hadamard) -> nearest
// centroid -> nibble-pack -> recon-norm-correct.
// wave64-safe: shared-memory tree reductions, no subgroup ops.
shared float s_x[64];     // working values (normalized in place)
shared float s_red[64];   // tree-reduction / nibble-share scratch

void main() {
    const uint j         = gl_LocalInvocationID.x;   // 0..63, element within the turbo4_64 block
    const uint token     = gl_WorkGroupID.x;         // global token index
    const uint y_idx     = gl_WorkGroupID.y;         // kv_head*N_QBLK + qb
    const uint kv_select = gl_WorkGroupID.z;         // 0 = K, 1 = V

    if (token >= p.n_tokens) {
        return;                                      // uniform across workgroup
    }

    const uint N_QBLK = p.HS / 64u;
    const uint kv_head = y_idx / N_QBLK;
    const uint qb      = y_idx % N_QBLK;

    const int slot = slot_mapping[token];
    if (slot < 0) {
        return;                                      // padding token (uniform)
    }

    const uint paged_block = uint(slot) / p.BS;
    const uint tok         = uint(slot) % p.BS;
    const uint d           = qb * 64u + j;

    // K_cur / V_cur layout: ne[0]=head_dim, ne[1]=n_kv_heads, ne[2]=n_tokens.
    const uint src = token * p.n_kv_heads * p.HS + kv_head * p.HS + d;
    const float val = (kv_select == 0u) ? float(k_cur[src]) : float(v_cur[src]);

    const uint block_ib = pa_turbo64_block_index(paged_block, kv_head, p.n_kv_heads, tok, qb, p.HS, p.BS);

    // ---- Step 1: load into shared mem ----
    s_x[j] = val;
    barrier();

    // ---- Step 2: parallel L2 norm (6-stage binary tree) ----
    s_red[j] = s_x[j] * s_x[j];
    barrier();
    if (j < 32u) { s_red[j] += s_red[j + 32u]; } barrier();
    if (j < 16u) { s_red[j] += s_red[j + 16u]; } barrier();
    if (j <  8u) { s_red[j] += s_red[j +  8u]; } barrier();
    if (j <  4u) { s_red[j] += s_red[j +  4u]; } barrier();
    if (j <  2u) { s_red[j] += s_red[j +  2u]; } barrier();
    if (j <  1u) { s_red[j] += s_red[j +  1u]; } barrier();

    const float grp_norm = sqrt(s_red[0]);
    const float inv_norm = (grp_norm > 1e-10f) ? (1.0f / grp_norm) : 0.0f;

    // ---- Step 3: normalize ----
    s_x[j] *= inv_norm;
    barrier();

    // ---- Step 4: (intentionally NO Randomized Hadamard Transform) ----

    // ---- Step 5: nearest centroid (N=64-calibrated table, not turbo4_0's) ----
    const uint idx = pa_turbo64_nearest_4bit(s_x[j]);

    // ---- Step 7 (parallel): reconstruction norm = sqrt(Σ centroid²) ----
    // WAR: all lanes have read s_red[0] (grp_norm) before any lane overwrites it.
    barrier();
    const float cv = TURBO_CENTROIDS_4BIT_N64[idx];
    s_red[j] = cv * cv;
    barrier();
    if (j < 32u) { s_red[j] += s_red[j + 32u]; } barrier();
    if (j < 16u) { s_red[j] += s_red[j + 16u]; } barrier();
    if (j <  8u) { s_red[j] += s_red[j +  8u]; } barrier();
    if (j <  4u) { s_red[j] += s_red[j +  4u]; } barrier();
    if (j <  2u) { s_red[j] += s_red[j +  2u]; } barrier();
    if (j <  1u) { s_red[j] += s_red[j +  1u]; } barrier();

    const float recon_norm     = sqrt(s_red[0]);
    const float corrected_norm = (recon_norm > 1e-10f) ? (grp_norm / recon_norm) : grp_norm;

    // ---- Step 6: nibble-pack qs cooperatively ----
    // Share indices via s_red so even lanes can pair them. WAR: all lanes have
    // consumed s_red[0] (recon_norm) before any lane overwrites s_red.
    barrier();
    s_red[j] = float(idx);
    barrier();

    // ---- Step 8: thread 0 writes the per-block scalar (NO rnorm field) ----
    if (j == 0u) {
        if (kv_select == 0u) {
            data_k[block_ib].norm = float16_t(corrected_norm);
        } else {
            data_v[block_ib].norm = float16_t(corrected_norm);
        }
    }

    if ((j & 1u) == 0u) {
        const uint lo = uint(s_red[j]);
        const uint hi = uint(s_red[j + 1u]);
        const uint8_t packed = uint8_t((lo & 0xFu) | ((hi & 0xFu) << 4u));
        if (kv_select == 0u) {
            data_k[block_ib].qs[j >> 1u] = packed;
        } else {
            data_v[block_ib].qs[j >> 1u] = packed;
        }
    }
}
#endif // DATA_A_TURBO4_64

#ifdef DATA_A_TURBO4_64_OL
// Cooperative turbo4_64_ol/ol8/ol12 quantizer (SP2.5, 2026-07-01; OL8/OL12
// added 2026-07-01 for the outlier-matrix sweep). Identical pipeline to the
// turbo4_64 quantizer above, but PA_TURBO4_64_OL_N fixed channel positions
// (PA_TURBO4_64_OL_CHANNELS, see paged_cache_ops.glsl) are excluded from the
// group-norm computation and stored verbatim at f16 in
// data_k/data_v[...].outliers[]; the remaining (64-N) elements are
// centroid-quantized with the SHARED TURBO_CENTROIDS_4BIT table by default
// (pa_turbo_nearest_4bit_sel), NOT the N=64-calibrated one used by plain
// turbo4_64 — unless GGML_TURBO4_64_OL_TABLE=n64 selects it via
// p.use_n64_table (investigative-only, see paged_cache_ops.glsl).
// wave64-safe: shared-memory tree reductions only, no subgroup ops.
shared float   s_x[64];       // working values (normalized in place)
shared float   s_red[64];     // tree-reduction scratch
shared uint8_t s_nib_idx[64u - PA_TURBO4_64_OL_N]; // packed-nibble staging, keyed by nib (not j)

void main() {
    const uint j         = gl_LocalInvocationID.x;   // 0..63, element within the block
    const uint token     = gl_WorkGroupID.x;         // global token index
    const uint y_idx     = gl_WorkGroupID.y;         // kv_head*N_QBLK + qb
    const uint kv_select = gl_WorkGroupID.z;         // 0 = K, 1 = V

    if (token >= p.n_tokens) {
        return;                                      // uniform across workgroup
    }

    const uint N_QBLK = p.HS / 64u;
    const uint kv_head = y_idx / N_QBLK;
    const uint qb      = y_idx % N_QBLK;

    const int slot = slot_mapping[token];
    if (slot < 0) {
        return;                                      // padding token (uniform)
    }

    const uint paged_block = uint(slot) / p.BS;
    const uint tok         = uint(slot) % p.BS;
    const uint d           = qb * 64u + j;

    // K_cur / V_cur layout: ne[0]=head_dim, ne[1]=n_kv_heads, ne[2]=n_tokens.
    const uint src = token * p.n_kv_heads * p.HS + kv_head * p.HS + d;
    const float val = (kv_select == 0u) ? float(k_cur[src]) : float(v_cur[src]);

    const uint block_ib = pa_turbo64_ol_block_index(paged_block, kv_head, p.n_kv_heads, tok, qb, p.HS, p.BS);

    // ---- Step 1: load into shared mem ----
    s_x[j] = val;
    barrier();

    // Classify this thread's channel (j == iqs since qb is always 0 for
    // HEAD_SIZE==64).
    uint outlier_slot, nib;
    const bool is_outlier = pa_turbo64_ol_classify(j, outlier_slot, nib);

    if (is_outlier) {
        if (kv_select == 0u) {
            data_k[block_ib].outliers[outlier_slot] = float16_t(s_x[j]);
        } else {
            data_v[block_ib].outliers[outlier_slot] = float16_t(s_x[j]);
        }
    }

    // ---- Step 2: parallel L2 norm over the 60 non-outlier elements only ----
    s_red[j] = is_outlier ? 0.0f : (s_x[j] * s_x[j]);
    barrier();
    if (j < 32u) { s_red[j] += s_red[j + 32u]; } barrier();
    if (j < 16u) { s_red[j] += s_red[j + 16u]; } barrier();
    if (j <  8u) { s_red[j] += s_red[j +  8u]; } barrier();
    if (j <  4u) { s_red[j] += s_red[j +  4u]; } barrier();
    if (j <  2u) { s_red[j] += s_red[j +  2u]; } barrier();
    if (j <  1u) { s_red[j] += s_red[j +  1u]; } barrier();

    const float grp_norm = sqrt(s_red[0]);
    const float inv_norm = (grp_norm > 1e-10f) ? (1.0f / grp_norm) : 0.0f;

    // ---- Step 3: normalize ----
    s_x[j] *= inv_norm;
    barrier();

    // ---- Step 4: (intentionally NO Randomized Hadamard Transform) ----

    // ---- Step 5: nearest centroid for non-outlier elements (shared table by
    // default; p.use_n64_table selects the N=64-calibrated one instead —
    // investigative-only, see paged_cache_ops.glsl) ----
    const bool  use_n64 = (p.use_n64_table != 0u);
    const uint idx = is_outlier ? 0u : pa_turbo_nearest_4bit_sel(s_x[j], use_n64);

    // ---- Step 7 (parallel): reconstruction norm over non-outlier elements ----
    // WAR: all lanes have read s_red[0] (grp_norm) before any lane overwrites it.
    barrier();
    const float cv = is_outlier ? 0.0f : pa_turbo_centroid_4bit_sel(idx, use_n64);
    s_red[j] = cv * cv;
    barrier();
    if (j < 32u) { s_red[j] += s_red[j + 32u]; } barrier();
    if (j < 16u) { s_red[j] += s_red[j + 16u]; } barrier();
    if (j <  8u) { s_red[j] += s_red[j +  8u]; } barrier();
    if (j <  4u) { s_red[j] += s_red[j +  4u]; } barrier();
    if (j <  2u) { s_red[j] += s_red[j +  2u]; } barrier();
    if (j <  1u) { s_red[j] += s_red[j +  1u]; } barrier();

    const float recon_norm     = sqrt(s_red[0]);
    const float corrected_norm = (recon_norm > 1e-10f) ? (grp_norm / recon_norm) : grp_norm;

    // ---- Step 6: nibble-pack qs, keyed by nib (not j) ----
    // With only 4 outliers interleaved among 64 positions, (j, j+1) pairs
    // don't reliably correspond to (nib, nib+1) pairs near an outlier
    // position, so pairing by j parity (as turbo4_0/turbo4_64 do) is unsafe
    // here. Stage into a shared array keyed by nib instead, then let 30
    // threads (one per output byte) pack pairs.
    if (!is_outlier) {
        s_nib_idx[nib] = uint8_t(idx);
    }
    barrier();

    // ---- Step 8: thread 0 writes the per-block norm ----
    if (j == 0u) {
        if (kv_select == 0u) {
            data_k[block_ib].norm = float16_t(corrected_norm);
        } else {
            data_v[block_ib].norm = float16_t(corrected_norm);
        }
    }

    if (j < (64u - PA_TURBO4_64_OL_N) / 2u) {
        const uint lo = uint(s_nib_idx[2u * j]);
        const uint hi = uint(s_nib_idx[2u * j + 1u]);
        const uint8_t packed = uint8_t((lo & 0xFu) | ((hi & 0xFu) << 4u));
        if (kv_select == 0u) {
            data_k[block_ib].qs[j] = packed;
        } else {
            data_v[block_ib].qs[j] = packed;
        }
    }
}
#endif // DATA_A_TURBO4_64_OL

#ifdef DATA_A_Q8_0
// Cooperative Q8_0 quantizer. Mirrors mt_scatter_kv_q8_0_kernel
// (mt_pagedattn.cu:223-310): one workgroup per (token, kv_head*N_QBLK+qb, K/V),
// 32 threads = one q8_0 block (one thread per element, matching CUDA's
// one-warp-per-block design). Sequence: load -> per-block max(|x|) ->
// scale = amax/127 -> round-to-nearest quantize. No Hadamard, no centroid
// table, no norm-correction — a plain per-block affine (scale-only) quant.
// wave64-safe: shared-memory tree reduction, no subgroup ops.
shared float s_x[32];     // working values
shared float s_red[32];   // tree-reduction scratch (max |x|)

void main() {
    const uint j         = gl_LocalInvocationID.x;   // 0..31, element within the q8_0 block
    const uint token     = gl_WorkGroupID.x;         // global token index
    const uint y_idx     = gl_WorkGroupID.y;         // kv_head*N_QBLK + qb
    const uint kv_select = gl_WorkGroupID.z;         // 0 = K, 1 = V

    if (token >= p.n_tokens) {
        return;                                      // uniform across workgroup
    }

    const uint N_QBLK = p.HS / 32u;
    const uint kv_head = y_idx / N_QBLK;
    const uint qb      = y_idx % N_QBLK;

    const int slot = slot_mapping[token];
    if (slot < 0) {
        return;                                      // padding token (uniform)
    }

    const uint paged_block = uint(slot) / p.BS;
    const uint tok         = uint(slot) % p.BS;
    const uint d           = qb * 32u + j;

    // K_cur / V_cur layout: ne[0]=head_dim, ne[1]=n_kv_heads, ne[2]=n_tokens.
    const uint src = token * p.n_kv_heads * p.HS + kv_head * p.HS + d;
    const float val = (kv_select == 0u) ? float(k_cur[src]) : float(v_cur[src]);

    const uint block_ib = pa_q80_block_index(paged_block, kv_head, p.n_kv_heads, tok, qb, p.HS, p.BS);

    // ---- Step 1: load into shared mem ----
    s_x[j] = val;
    barrier();

    // ---- Step 2: parallel max(|x|) (5-stage binary tree) ----
    s_red[j] = abs(s_x[j]);
    barrier();
    if (j < 16u) { s_red[j] = max(s_red[j], s_red[j + 16u]); } barrier();
    if (j <  8u) { s_red[j] = max(s_red[j], s_red[j +  8u]); } barrier();
    if (j <  4u) { s_red[j] = max(s_red[j], s_red[j +  4u]); } barrier();
    if (j <  2u) { s_red[j] = max(s_red[j], s_red[j +  2u]); } barrier();
    if (j <  1u) { s_red[j] = max(s_red[j], s_red[j +  1u]); } barrier();

    const float scale     = s_red[0] / 127.0f;
    const float inv_scale = (scale > 1e-10f) ? (1.0f / scale) : 0.0f;

    // ---- Step 3: quantize (round-to-nearest, GLSL round() — symmetric at .5) ----
    const int q = int(round(s_x[j] * inv_scale));

    // ---- Step 4: thread 0 writes the per-block scale; every thread writes its qs byte ----
    if (j == 0u) {
        if (kv_select == 0u) {
            data_k[block_ib].d = float16_t(scale);
        } else {
            data_v[block_ib].d = float16_t(scale);
        }
    }

    if (kv_select == 0u) {
        data_k[block_ib].qs[j] = int8_t(q);
    } else {
        data_v[block_ib].qs[j] = int8_t(q);
    }
}
#endif // DATA_A_Q8_0
